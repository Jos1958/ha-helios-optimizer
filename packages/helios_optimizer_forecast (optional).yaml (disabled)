###########################################################################################################
# HELIOS SOLAR FORECAST API - PAS AAN VOOR JOUW ZONNEPANELEN / OMVORMER / LOCATIE !!!!!
###########################################################################################################

# Forecast Solar Raw data wordt gebruikt vertaald in een template in helios_optimizer.yaml
#   helios_optimizer_forecast_solar_raw (Wh) ==> sensor.helios_optimizer_forecast_solar_hours (kWh)
# Om je eigen forecast te configureren heb je het volgende nodig: 
# - Peak Vermogen in kW   : b.v. 20 panelen x 395 Watt Peak = 8.0 kW (Geen rekening gehouden met clipping van de omvormer)
# - De richting van je dak: b.v. 175 gr (Dak op het Oost=90gr, Zuid=180gr, West=270gr, in mijn geval bijna Zuid: 175gr)
#   LET OP: In de REST API trekken we 180 graden af: Dus bijna Zuid: 175gr->-5, Oost: 90->-90, Zuid: 180->0, West: 270gr->90 !!!!! 
# - Dak hoek              : 48gr (Gebruikelijk ergens tussen 40-60gr)
# - Locatie van je huis   : b.v. Latitude: 52.370, Longitude: 4.895 (voor Amsterdam Centrum)
#     Zie: https://doc.forecast.solar/doku.php?id=find_your_azimuth voor details
#     In Home Assistant kun je de Locatie waardes vinden: Instellingen - Ruimtes, Labels & Zones - Zones - Thuis - <Wijzig>  -> Latitude en Longitude
#     Google Maps https://www.google.com/maps?q=52.370216%2C4.895168   \
#     Let op: Google gebruik standaard een locatie in graden maar kan ook de latitude en longitude weergeven (staat onder de graden)
# - Scan Interval         : 3600 (minimaal ieder uur of zet hem op 86400 voor iedere dag en maak een automation die hem op een schema aanroept)
#
# De result attributen bevatten Vermogen (Power) in W en Energie in Wh (NIET in kWh), daarom is het template nodig 
#
# Pas hieronder in de RESOURCE de waardes aan voor je eigen situatie:
#  "https://api.forecast.solar/estimate/52.370/4.895/48/-5/8.0"                                        <== voorbeeld voor Adam
#  "https://api.forecast.solar/estimate/latitude/longitude/dak-hoek/dak-richting-180/peak-vermogen"    <== wat invullen
rest:
  - resource: "https://api.forecast.solar/estimate/52.370/4.895/48/-5/8.0"
    scan_interval: 3600
    sensor:
      - name: Helios Optimizer Forecast Solar Raw
        unique_id: helios_optimizer_forecast_solar_raw
        value_template: "{{ value_json.message.code }}"
        json_attributes:
          - result

# TEMPLATE SENSOR:
template:
  - sensor:
      # Convert the Helios Optimizer Forecast Solar Raw (determined via the REST api) to the Helios Optimizer Forecast Solar Hours 
      # The Raw version has values in in Wh (Watt Hours) per Period, the Hours version has values in kWh per Period
      # WARNING: For 1 hour periods the Solar Power (kW) is the same as Solar Forecast (kWh) for the period
      #  However for 15 min periods the Solar Power (kW) will be 4x the Solar Forecast (kWh) for the period
      # The Raw version only has hours with sun and uses sunrise and sunset in the arrays
      # The Hours version includes all 24 hours of the day starting with 01 uptil 24 (with 0 before sunrise and after sunset)
      # Sunrise and Sunset values are set from the first and last (partial) hour in the raw version
      # Remark: The Helios Optimizer Forecast Solar Raw State Value is always 0 Wh (as a result the Solar Hours State Value is alway 0 kWh)
      - name: Helios Optimizer Forecast Solar Hours (REST api)
        unique_id: helios_optimizer_forecast_solar_hours
        default_entity_id: sensor.helios_optimizer_forecast_solar_hours
        unit_of_measurement: "kWh"
        device_class: energy
        state: >
          {{ ((states('sensor.helios_optimizer_forecast_solar_raw') | default(0) | int(0)) / 1000) | round(1) }}

        attributes:
          result: >
            {% set raw_sensor = 'sensor.helios_optimizer_forecast_solar_raw' %} 
            {% set ns = namespace(hours_kwh=[], days=[], sunrise=[], sunset=[]) %}
            {% set forecast_periods = state_attr(raw_sensor ,'result')['watt_hours_period'] | default({}) %}
            {% for i in range(48) %} {# Initialize forecast array for 48 hours (2 days) #}
              {% set ns.hours_kwh = ns.hours_kwh + [0] %}
            {% endfor %}
              
            {% set ns.days = state_attr(raw_sensor ,'result')['watt_hours_day'] | default({}) %}
            {% set day_list = ns.days | list %}    

            {% set today = day_list[0] if (day_list | count > 0) else now().strftime('%Y-%m-%d') %} {# first key and first 10 characters is the first date #}
            {% set tomorrow = (as_datetime(today) + timedelta(days=1)).strftime('%Y-%m-%d') %} {# Next day is first date plus 1 day #}
            {% set ns.start = today %}
            {% set ns.end   = tomorrow %}

            {% set today_total = (((ns.days[today] | int(0)) / 1000) | round(1)) if ns.days.get(today) else 0 %}
            {% set tomorrow_total = (((ns.days[tomorrow] | int(0)) / 1000) | round(1)) if ns.days.get(tomorrow) else 0 %}
            {% set ns.totals = {today: today_total, tomorrow: tomorrow_total} %}
              
            {% for ts, value in forecast_periods.items() %} {# for each hour in the forecast hours #}
              {% set dt = as_datetime(ts) %}
 
              {# Determine sunrise and sunset (does not work when sunrise/sunset is exactly on the hour!) #}
              {% set sunrise = false %}
              {% set sunset  = false %}
              {% set idx = dt.hour %}  {# Index is hour of timestamp #}
              {% if ((dt.minute > 0) and (dt.second > 0)) %} {# Not on the hour #}
                {% if (dt.hour < 12) %}			
                  {% set sunrise = true %}
                {% else %}
                  {% set idx = idx + 1 %}  {# Add an additional hour for sunset #}
                  {% set sunset = true %}
                {% endif %}
              {% endif %}
                     
              {% if dt.strftime('%Y-%m-%d') == today %}
                {% set idx = idx %} {# hours for today are already ok #}
                {% set ns.sunrise = ns.sunrise + [ts] if sunrise else ns.sunrise %} {# Add sunrise for today to the sunrise array #}
                {% set ns.sunset  = ns.sunset  + [ts] if sunset  else ns.sunset  %} {# Add sunset  for today to the sunset  array #}
              {% elif dt.strftime('%Y-%m-%d') == tomorrow %}
                {% set idx = idx + 24 %} {# add 24 hours (1 day) for tomorrow  #}
                {% set ns.sunrise = ns.sunrise + [ts] if sunrise else ns.sunrise %} {# Add sunrise for tomorrow to the sunrise array #}
                {% set ns.sunset  = ns.sunset  + [ts] if sunset  else ns.sunset  %} {# Add sunset  for tomorrow to the sunset  array #}
              {% else %}
                {% set idx = 0 %} {# Invalid day #}
              {% endif %}
 
              {% if idx > 0 %}
                {# Remove for the index in the array the existing 0 value and replace by the actual hour value in kWh #}
                {# A complex way in jinja for ns.hours_kwh[idx] = ((value | int(0)) / 1000) | round(1) #}
                {% set ns.hours_kwh = ns.hours_kwh[:idx-1] + [((value | int(0) ) / 1000) | round(3)] + ns.hours_kwh[idx:] %} 
              {% endif %}
            {% endfor %}
            {{ {'hours_kwh': ns.hours_kwh, 'start': ns.start, 'end': ns.end, 'interval': 60, 'days_kwh': ns.totals, 'days_wh': ns.days, 'sunrise': ns.sunrise, 'sunset': ns.sunset} }}      
        availability: >
          {{ has_value('sensor.helios_optimizer_forecast_solar_raw') }} 
