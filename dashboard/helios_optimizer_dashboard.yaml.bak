views:
  - type: sections
    path: jos-helios-controls
    max_columns: 3
    title: Helios Controls
    icon: mdi:shield-sun-outline
    header:
      layout: center
      badges_position: top
      badges_wrap: wrap
      card:
        type: markdown
        content: |
          # Helios Optimizer Dashboard for {{ user }} 
          Home Energy Linear Integrated Optimization Service 
        visibility:
          - condition: user
            users:
              - aeb5f377cffb469180f9b97c7136f6ae
              - aeb5f377cffb469180f9b97c7136f6ae
    sections:
      - type: grid
        cards:
          - type: picture
            image:
              media_content_id: /local/HeliosOptimizerBanner.jpeg
              media_content_type: ''
              metadata:
                navigateIds:
                  - {}
                  - media_content_type: ''
                    media_content_id: __MANUAL_ENTRY__
            grid_options:
              columns: full
            alt_text: Helios Optimizer
            double_tap_action:
              action: perform-action
              perform_action: pyscript.helios_optimizer_automation
              target: {}
        column_span: 3
      - type: grid
        background:
          color: yellow
          opacity: 16
        column_span: 3
        cards:
          - type: tile
            entity: input_number.helios_optimizer_energy_plan
            name: Result
            icon: mdi:calculator-variant
            card_mod:
              style: |
                ha-tile-icon {
                  --tile-color: {% if state_attr('input_number.helios_optimizer_energy_plan', 'success') == true %} green {% else %} red {% endif %} !important;
                }
            show_entity_picture: true
            hide_state: false
            state_content:
              - success
              - total_fun_cost
              - total_grid_cost
            vertical: false
            features_position: bottom
          - type: tile
            entity: input_number.helios_optimizer_energy_plan
            name: Calculation
            icon: mdi:home-battery
            show_entity_picture: true
            hide_state: false
            state_content:
              - calc_result
              - solver_iterations
            vertical: false
            features_position: bottom
            card_mod:
              style: |
                ha-tile-icon {
                  --tile-color: {% if state_attr('input_number.helios_optimizer_energy_plan', 'success') == true %} green {% else %} red {% endif %} !important;
                }
          - type: tile
            grid_options:
              columns: 12
              rows: 1
            entity: input_number.helios_optimizer_energy_plan
            name: Last Optimization Run
            icon: mdi:shield-sun-outline
            show_entity_picture: true
            hide_state: false
            state_content:
              - last_run_started
              - service_calc_time_ms
              - solver_execution_time_ms
            vertical: false
            features_position: bottom
          - type: tile
            grid_options:
              columns: 12
              rows: 1
            entity: input_number.helios_optimizer_energy_plan
            name: Optimization Period Start
            icon: mdi:timer-outline
            show_entity_picture: true
            hide_state: false
            state_content:
              - base_step
              - base_time
            vertical: false
            features_position: bottom
          - type: tile
            grid_options:
              columns: 12
              rows: auto
            entity: input_number.helios_optimizer_energy_plan
            name: Optimization Period Active Step
            icon: mdi:shoe-print
            show_entity_picture: false
            hide_state: false
            state_content:
              - active_step
              - active_time
            vertical: false
            features_position: bottom
          - type: tile
            grid_options:
              columns: 12
              rows: 1
            entity: input_number.helios_optimizer_energy_plan
            name: Optimization Period End
            icon: mdi:timer-outline
            show_entity_picture: true
            hide_state: false
            state_content:
              - end_step
              - end_time
            vertical: false
            features_position: bottom
          - type: tile
            grid_options:
              columns: 12
              rows: auto
            entity: input_number.helios_optimizer_energy_plan
            name: Battery Cap, Start & End (kWh)
            icon: mdi:battery-60
            show_entity_picture: false
            hide_state: false
            state_content:
              - capacity_kwh
              - soc_start_kwh
              - soc_end_kwh
            vertical: false
            features_position: bottom
          - type: tile
            grid_options:
              columns: 24
              rows: 1
            entity: input_number.helios_optimizer_energy_plan
            name: Solver Status
            icon: mdi:message
            card_mod:
              style: |
                ha-tile-icon {
                  --tile-color: {% if state_attr('input_number.helios_optimizer_energy_plan', 'success') == true %} green {% else %} red {% endif %} !important;
                }
            show_entity_picture: true
            hide_state: false
            state_content: solver_message
            vertical: false
            features_position: bottom
          - type: tile
            grid_options:
              columns: 12
              rows: auto
            entity: input_number.helios_optimizer_energy_plan
            name: Helios, Python & SciPy Version
            icon: mdi:program
            show_entity_picture: false
            hide_state: false
            state_content:
              - version
              - python
              - scipy
            vertical: false
            features_position: bottom
            visibility:
              - condition: user
                users:
                  - e3660168261a4344a4c14e358c2ba336
                  - 6f5834a212c040e290a60b1b550dbdda
      - type: grid
        column_span: 3
        cards:
          - type: heading
            heading: 'Helios Optimizer: Energy Plan Calculator'
            heading_style: title
            icon: mdi:medication
          - type: heading
            icon: mdi:information
            heading: Optimization Input Parameters and Results
            heading_style: subtitle
            tap_action:
              action: url
              url_path: >-
                https://docs.homebatterycontrol.com/xx-helios-strategy.html#input_params
          - type: markdown
            content: >-
              <font color="grey">

              <i>The <b>Helios Optimizer Service</b> will typically run every
              <b>quarter</b> of an hour and can be <b>manually</b> started with
              the <b>Start Helios</b> button.<br>

              A short <b>Overview</b> of the Optimizer Results is displayed
              <b>above</b> and the <b>Input Parameters</b> and more <b>Detailed
              Results</b> of the calculated Optimized Energy Plan are displayed
              <b>below</b> (e.g. Status Blocks, Graph and Table).<br>

              <b>Remark:</b>IN THE FUTURE more detailed information via the link
              above.

              </i></font>
            grid_options:
              columns: full
          - type: custom:button-card
            entity: input_boolean.helios_optimizer_running
            name: |
              [[[
                if (entity && entity.state === 'on')
                  return 'Helios Energy Optimizer (Running...)';
                return 'Start Helios Optimizer Task';
              ]]]
            show_icon: false
            grid_options:
              rows: auto
              columns: full
            tap_action:
              action: call-service
              service: pyscript.helios_optimizer_automation
              haptic: heavy
            styles:
              card:
                - background-color: |
                    [[[
                      if (entity && entity.state === 'on')
                        return '#ff9800'; // ORANJE wanneer hij getriggerd wordt
                      return '#2e7d32';   // GROEN in ruststand
                    ]]]
                - color: '#ffffff'
                - font-weight: bold
                - transition: background-color 0.2s ease
        background:
          color: yellow
          opacity: 16
      - type: grid
        column_span: 1
        background:
          color: yellow
          opacity: 16
        cards:
          - type: heading
            icon: mdi:weather-sunny
            heading: Optimization Parameters
            heading_style: subtitle
            grid_options:
              columns: 12
              rows: auto
          - type: markdown
            content: >-
              <font color="grey"><i>The <b>settings</b> below tune how the
              Helios Optimizer runs. Use <b>Steps 48</b> and <b>Step Size 60</b>
              minutes for a typical run with a horizon of <b>2 days</b>. 


              <b>Important Remark</b>: Use an <b>automatic</b> start step
              (<b>zero</b>). Only use a specific start step for
              <b>Simulation</b> runs!

              </i></font>
          - type: entities
            entities:
              - entity: input_number.helios_optimizer_steps
                name: Steps
              - entity: input_select.helios_optimizer_step_size
                name: Step Size (Minutes)
              - entity: input_number.helios_optimizer_start_step
                name: Start Step (Zero is Automatic)
              - entity: input_number.helios_optimizer_house_daily_usage
                name: House Daily Usage (Average)
              - entity: input_text.helios_optimizer_house_daily_distr
                name: House Daily Usage Distribution (24 Hours)
              - entity: input_select.helios_optimizer_solar_mode
                name: Solar Mode
              - entity: input_number.helios_optimizer_max_grid_import
                name: Max Grid Import
              - entity: input_number.helios_optimizer_max_grid_export
                name: Max Grid Export
              - entity: input_select.helios_optimizer_forecast_solar_sensor
                name: Sensor with the Forecast Solar Hours
      - type: grid
        column_span: 1
        background:
          color: yellow
          opacity: 16
        cards:
          - type: heading
            icon: mdi:weather-sunny
            heading: Battery Parameters
            heading_style: subtitle
            grid_options:
              columns: 12
              rows: auto
          - type: markdown
            content: >-
              <font color="grey"><i>The <b>settings</b> below tune how the
              Helios Optimizer uses the battery. 

              </i></font>
          - type: entities
            entities:
              - entity: input_boolean.helios_optimizer_battery_enabled
                name: Battery Enabled
              - entity: input_number.helios_optimizer_soc_target_pct
                name: Battery SOC Target
              - entity: input_number.helios_optimizer_soc_min_pct
                name: Battery SOC Min
              - entity: input_number.helios_optimizer_soc_max_pct
                name: Battery SOC Max
              - entity: input_number.helios_optimizer_charge_limit
                name: Battery Charge Limit
              - entity: input_number.helios_optimizer_discharge_limit
                name: Battery Discharge Limit
              - entity: input_number.helios_optimizer_charge_efficiency
                name: Battery Charge Efficiency
              - entity: input_number.helios_optimizer_discharge_efficiency
                name: Battery Discharge Efficiency
      - type: grid
        column_span: 1
        background:
          color: yellow
          opacity: 16
        cards:
          - type: heading
            icon: mdi:battery-charging-80
            heading_style: subtitle
            grid_options:
              columns: 12
              rows: auto
            heading: Derived Parameters
          - type: markdown
            content: >-
              <font color="grey"><i>The read-only <b>settings</b> below are
              retrieved from or generated for <b>HBC</b> and are only displayed
              for validation purposes. They should represent the (total) values
              for <u>all of your batteries</u> and are calculate from the <b>HBC
              Marstek</b> Entities using Helios templates or are generated by
              the Helios Optimizer.

              </i></font>
          - type: entities
            entities:
              - entity: input_text.helios_optimizer_version
                name: Helios Version
                card_mod:
                  style: |
                    :host{pointer-events: none; opacity: 0.6} 
              - entity: sensor.helios_template_hbc_maximum_energy
                name: Maximum Energy (All Batteries)
                card_mod:
                  style: |
                    :host{pointer-events: none; opacity: 0.6} 
              - entity: sensor.helios_template_hbc_remaining_energy
                name: Remaining Energy (All)
                card_mod:
                  style: |
                    :host{pointer-events: none; opacity: 0.6} 
              - entity: sensor.helios_template_hbc_total_soc
                name: Total SOC (All)
                card_mod:
                  style: |
                    :host{pointer-events: none; opacity: 0.6} 
              - entity: sensor.helios_template_hbc_max_charge_power
                name: Max Charge Power (All)
                card_mod:
                  style: |
                    :host{pointer-events: none; opacity: 0.6} 
              - entity: sensor.helios_template_hbc_max_discharge_power
                name: Max Discharge Power (All)
                card_mod:
                  style: |
                    :host{pointer-events: none; opacity: 0.6} 
              - entity: input_number.house_battery_strategy_sell_target_soc
                name: HBC Sell Target SOC %
                card_mod:
                  style: |
                    :host{pointer-events: none; opacity: 0.6} 
              - entity: input_number.house_battery_strategy_charge_target_soc
                name: HBC Charge Target SOC %
                card_mod:
                  style: |
                    :host{pointer-events: none; opacity: 0.6} 
              - entity: input_select.helios_optimizer_hbc_sub_strategy
                name: Helios HBC Sub Strategy
                card_mod:
                  style: |
                    :host{pointer-events: none; opacity: 0.6} 
              - entity: input_number.helios_optimizer_hbc_net_power
                name: Helios Net Battery Power for HBC
                card_mod:
                  style: |
                    :host{pointer-events: none; opacity: 0.6} 
      - type: grid
        column_span: 1
        background:
          color: yellow
          opacity: 16
        cards:
          - type: heading
            icon: mdi:battery-charging-80
            heading: HBC Battery Totals
            heading_style: subtitle
            grid_options:
              columns: 12
              rows: auto
          - type: markdown
            content: >-
              <font color="grey"><i>These parameters are retrieved from HBC but
              are not always available and are already compensated for min and
              max SOC values.</i></font>
          - type: entities
            entities:
              - entity: input_number.house_battery_count
                name: Battery Count
                card_mod:
                  style: |
                    :host {
                      pointer-events: none; /* Blokkeert alle muisklikken */
                      opacity: 0.6;         /* Maakt het veld grijs/read-only */
                    }
              - entity: input_number.house_battery_total_max_available_energy
                name: Maximum Energy
                card_mod:
                  style: |
                    :host{pointer-events: none; opacity: 0.6} 
              - entity: input_number.house_battery_total_available_energy
                name: Available Energy
                secondary_info: none
                card_mod:
                  style: |
                    :host{pointer-events: none; opacity: 0.6} 
              - entity: input_number.house_battery_total_battery_power
                name: Battery Power
                card_mod:
                  style: |
                    :host{pointer-events: none; opacity: 0.6} 
              - entity: input_number.house_battery_total_max_charge_power
                name: Max Charge Power
                card_mod:
                  style: |
                    :host{pointer-events: none; opacity: 0.6} 
              - entity: input_number.house_battery_total_max_discharge_power
                name: Max Discharge Power
                card_mod:
                  style: |
                    :host{pointer-events: none; opacity: 0.6} 
        visibility:
          - condition: user
            users:
              - aeb5f377cffb469180f9b97c7136f6ae
      - type: grid
        column_span: 3
        cards:
          - type: markdown
            content: Als deze tekst **ROOD** is, werkt card-mod!
            card_mod:
              style: |
                ha-card {
                  color: red !important;
                }
            grid_options:
              columns: full
            visibility:
              - condition: user
                users:
                  - aeb5f377cffb469180f9b97c7136f6ae
      - type: grid
        column_span: 3
        cards:
          - type: custom:apexcharts-card
            section_mode: true
            grid_options:
              columns: full
              rows: 8
            header:
              show: true
              title: Optimized Energy Plan
              show_states: false
              colorize_states: true
            apex_config:
              chart:
                width: 100%
              grid:
                padding:
                  left: 10
                  right: 10
              noData:
                text: No Energy Plan Data Available
                align: center
                verticalAlign: middle
                style:
                  color: '#888888'
                  fontSize: 14px
            yaxis:
              - id: power
                decimals: 1
                apex_config:
                  tickAmount: 5
                  title:
                    text: Power (kW)
              - id: soc
                opposite: true
                min: 0
                max: 100
                decimals: 0
                apex_config:
                  tickAmount: 5
                  title:
                    text: Battery SOC (%)
            graph_span: 48h
            span:
              start: day
            now:
              show: true
              label: Nu
              color: black
            series:
              - entity: input_number.helios_optimizer_energy_plan
                name: Battery SoC
                yaxis_id: soc
                show:
                  legend_value: false
                color: '#00E396'
                type: line
                stroke_width: 4
                data_generator: |
                  const pct_array = entity.attributes.plan.soc_pct;
                  return entity.attributes.plan.timestamp.map((time, i) => [
                    new Date(time).getTime(), pct_array?.[i] != null ? pct_array[i] : null
                  ]);
              - entity: input_number.helios_optimizer_energy_plan
                name: Battery (Discharge-Charge)
                yaxis_id: power
                show:
                  legend_value: false
                color: '#000FFB'
                type: area
                stroke_width: 2
                data_generator: |
                  return entity.attributes.plan.timestamp.map((time, index) => {
                    return [new Date(time).getTime(), entity.attributes.plan.battery_discharge_kw[index] - entity.attributes.plan.battery_charge_kw[index]];
                  });
                  const dis_array = entity.attributes.plan.battery_discharge_kw;
                  const cha_array = entity.attributes.plan.battery_charge_kw;
                  return entity.attributes.plan.timestamp.map((time, i) => [
                    new Date(time).getTime(), dis_array?.[i] != null ? dis_array[i] - cha_array[i] : null
                  ]);
              - entity: input_number.helios_optimizer_energy_plan
                name: Solar Forecast
                yaxis_id: power
                show:
                  legend_value: false
                color: '#FEB099'
                type: area
                opacity: 0.1
                stroke_width: 2
                data_generator: |
                  const for_array = entity.attributes.plan.solar_forecast_kw;
                  return entity.attributes.plan.timestamp.map((time, i) => [
                    new Date(time).getTime(), for_array?.[i] != null ? for_array[i] : null
                  ]);
              - entity: input_number.helios_optimizer_energy_plan
                name: Solar Production
                yaxis_id: power
                show:
                  legend_value: false
                color: '#FEB019'
                type: area
                opacity: 0.3
                stroke_width: 2
                data_generator: |
                  const prod_array = entity.attributes.plan.solar_production_kw;
                  return entity.attributes.plan.timestamp.map((time, i) => [
                    new Date(time).getTime(), prod_array?.[i] != null ? prod_array[i] : null
                  ]);
              - entity: input_number.helios_optimizer_energy_plan
                name: House Usage
                yaxis_id: power
                show:
                  legend_value: false
                color: '#FF4560'
                type: line
                stroke_width: 3
                data_generator: |
                  const house_array = entity.attributes.plan.house_usage_kw;
                  return entity.attributes.plan.timestamp.map((time, i) => [
                    new Date(time).getTime(), house_array?.[i] != null ? -house_array[i] : null
                  ]);
              - entity: input_number.helios_optimizer_energy_plan
                name: Grid (Import-Export)
                yaxis_id: power
                show:
                  legend_value: false
                color: '#008FFB'
                type: column
                opacity: 0.3
                stroke_width: 2
                data_generator: |
                  const colours = { sell: '#ff9800', buy: '#4caf50' };
                  const imp_array   = entity.attributes.plan.grid_import_kw;
                  const exp_array   = entity.attributes.plan.grid_export_kw;
                  const strat_array = entity.attributes.plan.strategy;
                  return entity.attributes.plan.timestamp.map((time, i) => [
                    new Date(time).getTime(), imp_array?.[i] != null ? imp_array[i] - exp_array[i] : null
                  ]);
              - entity: input_number.helios_optimizer_energy_plan
                name: EV Charging
                yaxis_id: power
                show:
                  legend_value: false
                color: '#775DD0'
                type: line
                stroke_width: 3
                data_generator: |
                  const ev_array = entity.attributes.plan.ev_charge_kw;
                  return entity.attributes.plan.timestamp.map((time, i) => [
                    new Date(time).getTime(), ev_array?.[i] != null ? ev_array[i] : null
                  ]);
      - type: grid
        cards:
          - type: heading
            heading: Helios Detailed Optimization Output
            heading_style: title
          - type: markdown
            title: Optimalization State
            grid_options:
              rows: auto
            content: >
              {%- set a =
              states.input_number.helios_optimizer_energy_plan.attributes |
              default(none) -%}

              {%- if a is defined and a is not none -%}
                | Optimization          | Values                 |
                | :---                  | :---                   |
                | **Success**           | {{ a.get('success') }} | 
                | **Result**            | {{ a.get('calc_result') }} | 
                | **Optimize Time**     | {{ a.get('optimize_time'     ) }} |
                | **Fun Cost**          | € {{ a.get('total_fun_cost'  ) }} |
                | **Total Step Cost**   | € {{ a.get('total_step_cost' ) }} |
                | **Total Delta Cost**  | € {{ a.get('total_delta_cost') }} |
                | **Total Grid Cost**   | € {{ a.get('total_grid_cost' ) }} |
                | **Steps**             | {{ a.get('steps'             ) }} |
                | **Step Size**         | {{ a.get('step_size'         ) }} min |
                | **Base Step**         | {{ a.get('base_step'         ) }} |
                | **Active Step**       | {{ a.get('active_step'       ) }} |
                | **End Step**          | {{ a.get('end_step'          ) }} |
                | **Period Base**       | {{ a.get('base_time'         ) }} |
                | **Period Active**     | {{ a.get('active_time'       ) }} |
                | **Period End**        | {{ a.get('end_time'          ) }} |
              {%- else -%}

              *No Optimized Energy Plan available.*

              {%- endif -%}
                
          - type: markdown
            title: Actuals for the Active step
            content: >
              {%- set c =
              state_attr('input_number.helios_optimizer_energy_plan', 'current')
              -%}

              {%- if c is defined and c is not none -%}
                {%- set step  = state_attr('input_number.helios_optimizer_energy_plan', 'active_step') | default(None) -%}
                {%- set start = state_attr('input_number.helios_optimizer_energy_plan', 'active_time') | default('')  -%}
              ?? **Active Step:** {{ step }}

              ??? **Step Start Time:** {{ start }}
                | Component | State | Power |
                | :--- | :---: | :---: |
                | ?? **Battery Strategy**  | **{{ c.battery_strategy }}**                                         | {{ c.grid_power_w        }} W |
                | ?? **Net Battery Power** | {{ '?? Discharge' if c.battery_net_power_w < 0 else ('?? Charge' if c.battery_net_power_w > 0 else '? Standby') }} | {{ c.battery_net_power_w }} W |
                | ?? **Battery Power**     |                                                                      | {{ c.battery_power_w     }} W |
                | ? **Charge Power**      | {{ '?? Active'   if c.battery_charge_w     > 0 else '? Standby' }} | {{ c.battery_charge_w    }} W |
                | ?? **Discharge Power**   | {{ '?? Active'   if c.battery_discharge_w  > 0 else '? Standby' }} | {{ c.battery_discharge_w }} W |
                | ? **Charge Limit**      | {{ '?? Active'   if c.max_charge_w         > 0 else '? Disabled'}} | {{ c.max_charge_w        }} W |
                | ?? **Discharge Limit**   | {{ '?? Active'   if c.max_discharge_w      > 0 else '? Disabled'}} | {{ c.max_discharge_w     }} W |
                | ? **Max Grid Import**   | {{ '?? Active'   if c.max_grid_import_w    > 0 else '? Off-Grid'}} | {{ c.max_grid_import_w   }} W |
                | ?? **Max Grid Export**   | {{ '?? Active'   if c.max_grid_export_w    > 0 else '? Disabled'}} | {{ c.max_grid_export_w   }} W |
              {%- elif false -%}  
                | ?? **EV Laadpaal**       | {{ '? Charge'   if c.ev_power_w           > 0 else '? Off'     }} | {{ c.ev_power_w          }} W |
                | ?? **Heatpump**          | {{ '?? Heat'     if c.hp_power_w           > 0 else '? Off'     }} | {{ c.hp_power_w          }} W |
                | ?? **Boiler**            | {{ '?? Heat Up'  if c.boiler_power_w       > 0 else '? Off'     }} | {{ c.boiler_power_w      }} W |
              {%- else -%}

              *No Current Strategy and Power available.*

              {%- endif -%}
          - type: markdown
            grid_options:
              rows: auto
            content: >
              {%- set a =
              states.input_number.helios_optimizer_energy_plan.attributes |
              default(none) -%}

              {%- if a is defined and a is not none -%}
                | Solar & Battery       | Values                 |
                | :---                  | :---                   |
                | **Solar Mode**        | {{ a.get('solar_mode'        ) }} |
                | **Battery Mode**      | {{ a.get('battery_mode'      ) }} |
                | **Capacity**          | {{ '%5.2f' | format(a.get('capacity_kwh'  ) or 0) }} kWh |
                | **SoC Target**        | {{ '%5.2f' | format(a.get('soc_target_kwh') or 0) }} kWh |
                | **SoC Min**           | {{ '%5.2f' | format(a.get('soc_min_kwh'   ) or 0) }} kWh |
                | **SoC Max**           | {{ '%5.2f' | format(a.get('soc_max_kwh'   ) or 0) }} kWh |
                | **SoC Start**         | {{ '%5.2f' | format(a.get('soc_start_kwh' ) or 0) }} kWh |
                | **SoC End**           | {{ '%5.2f' | format(a.get('soc_end_kwh'   ) or 0) }} kWh |
                | **SoC Target %**      | {{ '%4.1f' | format(a.get('soc_target_pct') or 0) }} %   |
                | **SoC Min %**         | {{ '%4.1f' | format(a.get('soc_min_pct'   ) or 0) }} %   |
                | **SoC Max %**         | {{ '%4.1f' | format(a.get('soc_max_pct'   ) or 0) }} %   |
                | **SoC Start %**       | {{ '%4.1f' | format(a.get('soc_start_pct' ) or 0) }} %   |
                | **SoC End %**         | {{ '%4.1f' | format(a.get('soc_end_pct'   ) or 0) }} %   |
              {%- else -%}

              *No Optimized Energy Plan available.*

              {%- endif -%}
                
            title: Solar & Battery
        column_span: 3
      - type: grid
        cards:
          - type: markdown
            title: Optimized Energy Plan
            content: >
              {%- set hdr1 = "| Time | Import (€) | Export (€) | FunCost (€) |
              House-For (kW) | House-Usg (kW) | Sun-For (kW) | Sun-Prod (kW) |
              Strategy | SoC (%) | SoC (kWh) | Grid-Net (kW) | Discharge (kW) |
              Charge (kW) |" -%}

              {%- set hdr2 = "| :--- |   ---: |   ---: | ---:    |  
              :---:        |   :---:        |  :---:       |  :---:        |
              :---:    | :---:   | :---:     | :---:    | :---:          |
              :---:       |" -%}

              {%- set p =
              state_attr('input_number.helios_optimizer_energy_plan', 'plan')
              -%}

              {%- if p and p.timestamp is defined and  p.timestamp | length > 0
              -%}
                {%- if p.ev_charge_kw != None -%}
                  {%- set hdr1 = hdr1 ~ " EV Charging (kW) |" -%} 
                  {%- set hdr2 = hdr2 ~ " :---:            |" -%} 
                {%- endif -%}
                {{ hdr1 }} 
                {{ hdr2 }}
                {%- for i in range(p.timestamp | length) -%}
                  {%- set t = p.timestamp[i].split(' ')[1][:5] -%}
                  {%- set imp_pr       = "%5.3f"| format(p.import_prices[i]) -%}
                  {%- set exp_pr       = "%5.3f"| format(p.export_prices[i]) -%}
                  {%- set step_cost    = "%5.3f"| format(p.step_costs[i]) -%}
                  {%- set house_for_kw = "%5.2f"  | format(p.house_forecast_kw[i]) -%}
                  {%- set house_usg_kw = "%5.2f"  | format(p.house_usage_kw[i]) -%}
                  {%- set sol_for_kw   = "%5.2f"  | format(p.solar_forecast_kw[i]) -%}     
                  {%- set sol_prod_kw  = "%5.2f"  | format(p.solar_production_kw[i]) -%}     
                  {%- set soc_pct      = "%4.1f"  | format(p.soc_pct[i]) -%}
                  {%- set soc_kwh      = "%5.2f"  | format(p.soc_kwh[i]) -%}
                  {%- set grid_net_kw  = "%5.2f"  | format(p.grid_import_kw[i] - p.grid_export_kw[i]) -%}

                  {%- set discharge_kw = "%5.2f"  | format(p.battery_discharge_kw[i] if p.battery_discharge_kw != None else 0) -%}
                  {%- set charge_kw    = "%5.2f"  | format(p.battery_charge_kw[i] if p.battery_charge_kw != None else 0) -%}
                  
                  {%- set ev_kw        = "%5.2f"  | format(p.ev_charge_kw[i] if p.ev_charge_kw != None else 0) -%}
                  {%- set hp_kw        = "%5.2f"  | format(p.heat_pump_kw[i] if p.heat_pump_kw != None else 0) -%}
                  {%- set boiler_kw    = "%5.2f"  | format(p.boiler_kw[i] if p.boiler_kw != None else 0) -%}
                  
                  {%- set row = "\n|" ~ t -%}
                  {%- set row = row ~ "|" ~ imp_pr ~ "|" ~ exp_pr -%} 
                  {%- set row = row ~ "|" ~ step_cost -%} 
                  {%- set row = row ~ "|" ~ house_for_kw -%} 
                  {%- set row = row ~ "|" ~ house_usg_kw -%} 
                  {%- set row = row ~ "|" ~ sol_for_kw -%}
                  {%- set row = row ~ "|" ~ sol_prod_kw -%}
                  {%- set row = row ~ "|" ~ p.strategy[i] -%}
                  {%- set row = row ~ "|" ~ soc_pct  ~ "|" ~  soc_kwh ~ "|" ~ grid_net_kw -%}
                  {%  set row = row ~ "|" ~ discharge_kw ~ "|" ~ charge_kw -%}
                  {%- set row = row ~ "|" ~ (ev_kw if p.ev_charge_kw != None else "n/a") -%}
                  {%- set row = row ~ "|" -%}
                  {{- row -}}  
                {%- endfor -%}
              {%- else -%}
                {{ "\n\n**No Energy Plan Data Available.**" }}
              {%- endif -%}
            grid_options:
              columns: full
        column_span: 3
      - type: grid
        cards:
          - type: markdown
            title: Optimalization Run
            grid_options:
              rows: auto
            content: >
              {%- set a =
              states.input_number.helios_optimizer_energy_plan.attributes |
              default(none) -%}

              {% if a is defined and a is not none %}
                | Run Info              | Values                     |
                | :---                  | :---                       |
                | **Success**           | {{ a.get('success')     }} | 
                | **Calc Code**         | {{ a.get('calc_code')   }} | 
                | **Calc Result**       | {{ a.get('calc_result') }} |  
                | **Helios Version**    | {{ a.get('version')     }} |
                | **SciPy Version**     | {{ a.get('scipy')       }} |
                | **Run Started**       | {{ a.get('last_run_started'    ) }} | 
                | **Run Stopped**       | {{ a.get('last_run_stopped'    ) }} |
                | **Run Time** (ms)     | {{ a.get('service_calc_time_ms') }} |  
                | **Solver Time** (ms)  | {{ a.get('solver_execution_time_ms') }} |
                | **Solver Iterations** | {{ a.get('solver_iterations')        }} |
                | **Solver Message**    | {{ a.get('solver_message')           }} |

              {% if a.get('error_trace') or a.get('performance_ms') %}
                **Debug Information:**
                | Error & Performance   | Details                       |
                | :---                  | :---                          |
                | **Insight Level**     | {{ a.get('insight')        }} |
                | **Error Trace**       | {{ a.get('error_trace')    }} |
                | **Phase Performance** | {{ a.get('performance_ms') }} |
              {% endif %}  

              {% else %}

              *No Optimized Energy Plan available.*

              {% endif %}
                
            visibility:
              - condition: user
                users:
                  - e3660168261a4344a4c14e358c2ba336
                  - 6f5834a212c040e290a60b1b550dbdda
        visibility:
          - condition: user
            users:
              - e3660168261a4344a4c14e358c2ba336
              - e3660168261a4344a4c14e358c2ba336
              - 6f5834a212c040e290a60b1b550dbdda
      - type: grid
        cards:
          - type: markdown
            grid_options:
              rows: auto
            content: >
              {%- set t =
              state_attr('input_number.helios_optimizer_energy_plan', 'totals')
              -%}

              {%- if t is defined and t is not none -%}
                | Total for Period        | Sum in kWh                                                      |
                | :---                    | :---                                                            |
                | **Input House Forecast**| {{ '%5.2f' | format(t.get('house_input_kwh'      ) or 0) }} kWh |
                | **Input Solar Forecast**| {{ '%5.2f' | format(t.get('solar_input_kwh'      ) or 0) }} kWh |
                | **House Forecast**      | {{ '%5.2f' | format(t.get('house_forecast_kwh'   ) or 0) }} kWh |
                | **House Usage**         | {{ '%5.2f' | format(t.get('house_usage_kwh'      ) or 0) }} kWh |
                | **Solar Forecast**      | {{ '%5.2f' | format(t.get('solar_forecast_kwh'   ) or 0) }} kWh |
                | **Solar Production**    | {{ '%5.2f' | format(t.get('solar_production_kwh' ) or 0) }} kWh |
                | **Battery Discharge**   | {{ '%5.2f' | format(t.get('battery_discharge_kwh') or 0) }} kWh |
                | **Battery Charge**      | {{ '%5.2f' | format(t.get('battery_charge_kwh'   ) or 0) }} kWh |
                | **Grid Import**         | {{ '%5.2f' | format(t.get('grid_import_kwh'      ) or 0) }} kWh |
                | **Grid Export**         | {{ '%5.2f' | format(t.get('grid_export_kwh'      ) or 0) }} kWh |
                | **Overall (near zero)** | {{ '%5.2f' | format(t.get('overall_kwh'          ) or 0) }} kWh |
                | **Solar Skipped**       | {{ '%5.2f' | format(t.get('solar_skipped_kwh'    ) or 0) }} kWh |
                | **House Skipped**       | {{ '%5.2f' | format(t.get('house_skipped_kwh'    ) or 0) }} kWh |
              {%- else -%}

              *No Totals available.*

              {%- endif -%}
                
            title: Energy Plan Totals
        visibility:
          - condition: user
            users:
              - e3660168261a4344a4c14e358c2ba336
              - e3660168261a4344a4c14e358c2ba336
              - 6f5834a212c040e290a60b1b550dbdda
